# LLM providers (set the one you're using)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval
COHERE_API_KEY=
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# Optional: self-hosted vLLM endpoint
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Eval
EVAL_JUDGE_MODEL=claude-3-5-sonnet-20241022

# Guardrails
GUARDRAILS_TOPIC_WHITELIST=docs/guardrails/topic_whitelist.json
GUARDRAILS_PII_BLOCK=true
